# Public site configuration
NEXT_PUBLIC_SITE_URL=https://viste.ai
NEXT_PUBLIC_BOOKING_URL=https://example.com/book
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ENABLE_OPPORTUNITY_MAPPER=false

# Supabase lead storage (use Preview values for previews)
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
SUPABASE_SECRET_KEY=sb_secret_example

# Contact notifications
CONTACT_NOTIFICATION_EMAIL=hello@example.com
CONTACT_FROM_EMAIL=Viste.ai Website <website@example.com>
RESEND_API_KEY=re_example
CONTACT_IP_SALT=replace-with-a-random-secret

# Optional OpenAI feature; disabled by default
OPENAI_API_KEY=sk-example
OPENAI_MODEL=gpt-5-mini
