# Public site configuration
NEXT_PUBLIC_SITE_URL=https://viste.ai
# Public Google Appointment Schedule, Cal.com or Calendly HTTPS URL.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ENABLE_OPPORTUNITY_MAPPER=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public legal-operator details. Leave blank until verified.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_COMPANY_NUMBER=
NEXT_PUBLIC_LEGAL_REGISTERED_ADDRESS=
NEXT_PUBLIC_LEGAL_TAX_VAT=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@example.com
NEXT_PUBLIC_SECURITY_CONTACT_EMAIL=security@example.com

# Public service configuration. Leave blank to use non-numeric scope language.
NEXT_PUBLIC_SPRINT_DURATION=
NEXT_PUBLIC_SPRINT_PARTICIPANTS=
NEXT_PUBLIC_SPRINT_DELIVERABLES=
NEXT_PUBLIC_SPRINT_STARTING_INVESTMENT=

# Founder data never renders unless all required fields are supplied and approved.
NEXT_PUBLIC_FOUNDER_APPROVED=false
NEXT_PUBLIC_FOUNDER_NAME=
NEXT_PUBLIC_FOUNDER_ROLE=
NEXT_PUBLIC_FOUNDER_BIO=
NEXT_PUBLIC_FOUNDER_IMAGE_URL=
NEXT_PUBLIC_FOUNDER_PROFILE_URL=

# Supabase lead storage (use Preview values for previews)
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
SUPABASE_SECRET_KEY=sb_secret_example

# Contact notifications
CONTACT_NOTIFICATION_EMAIL=hello@example.com
CONTACT_FROM_EMAIL=Viste.ai Website <website@example.com>
RESEND_API_KEY=re_example
CONTACT_IP_SALT=replace-with-a-random-secret
ANALYTICS_SESSION_SALT=replace-with-a-different-random-secret
TURNSTILE_SECRET_KEY=

# Optional server-side error alert destination. Error payloads contain no form data.
ERROR_MONITORING_WEBHOOK_URL=

# Optional OpenAI feature; disabled by default
OPENAI_API_KEY=sk-example
OPENAI_MODEL=gpt-5-mini

# VIS_010 provider adapters. Leave blank until the corresponding reviewed
# server-only adapter is implemented and the business-owned account is approved.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
